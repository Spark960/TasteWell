# Copy to .env (gitignored). NEVER commit real values.
# Qloo hackathon credential
QLOO_API_KEY=
# Hackathon keys ONLY work against the hackathon host — both vars required
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Agent brain: gemini | openai | groq | openrouter (OpenAI-compatible shim)
# Model is optional - omit to use the provider default.
LLM_PROVIDER=gemini
# LLM_MODEL=
GEMINI_API_KEY=
# optional fallback providers
OPENAI_API_KEY=
GROQ_API_KEY=
# OpenRouter (cheap paid routing; gpt-oss-20b ~0.07c, gpt-oss-120b ~0.5c/run)
OPENROUTER_API_KEY=

# App
APP_ENV=dev
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Deploy (P5) — Caddy/Let's Encrypt + DuckDNS
ACME_EMAIL=
DUCKDNS_DOMAIN=
